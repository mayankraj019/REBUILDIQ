# Environment Configuration Template for RebuildIQ
# Copy this file to .env and replace placeholder values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# -----------------------------------------------------------------------------
# Supabase Persistence, Auth & Storage (Recommended Primary Backend)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Optional Server-Only Privileged Key (NEVER prefix with NEXT_PUBLIC_)
# Enables immediate hard deletion of auth.users records on account deletion.
# Retrieve from Supabase Dashboard -> Project Settings -> API Keys (Secret key).
SUPABASE_SECRET_KEY=""

# Account deletion grace window (days) when soft-deletion retention applies
ACCOUNT_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Database Persistence (Prisma ORM / Direct Postgres Fallback)
# -----------------------------------------------------------------------------
# Local SQLite fallback or Supabase Postgres Pooler URI:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://rebuildiq_user:secure_password@localhost:5432/rebuildiq?schema=public"

# -----------------------------------------------------------------------------
# Authentication & Security Secrets
# -----------------------------------------------------------------------------
# Generate a secure 32+ character random key for session encryption:
# Example: openssl rand -base64 32
SESSION_SECRET="replace-with-a-cryptographically-secure-random-string-at-least-32-chars"
SESSION_MAX_AGE_SECONDS=604800

# -----------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini)
# -----------------------------------------------------------------------------
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# AI Provider selection: "gemini" (default) or "mock" (offline testing without API key)
AI_PROVIDER="mock"
GEMINI_MODEL="gemini-2.5-flash"

# -----------------------------------------------------------------------------
# Storage & Asset Configuration
# -----------------------------------------------------------------------------
# Storage driver: "local" (default) or "s3"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage"

# S3 Configuration (only required if STORAGE_DRIVER=s3)
# S3_BUCKET_NAME=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# Browser Worker & Crawler Limits
# -----------------------------------------------------------------------------
MAX_CONCURRENT_BROWSER_JOBS=2
BROWSER_PAGE_TIMEOUT_MS=30000
BROWSER_JOB_TIMEOUT_MS=180000
MAX_CRAWL_DEPTH=1
MAX_PAGES_PER_JOB=5
ENABLE_SSRF_FIREWALL=true
